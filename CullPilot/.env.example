# Spring Boot
SERVER_PORT=8080
DATABASE_URL=jdbc:sqlite:../data/cullpilot.db
STORAGE_ROOT=../storage

# Python API adapter
PYTHON_API_BASE_URL=http://127.0.0.1:8001
PYTHON_API_TIMEOUT_SECONDS=600

# Python service: use the same absolute storage directory as Spring Boot.
# STORAGE_ROOT=D:/PythonFile/CullPilot/storage
ANALYSIS_ENABLE_SEMANTIC=true
ANALYSIS_ENABLE_DEEPFACE=true
ANALYSIS_ENABLE_CHINESE_CLIP=true
DEEPFACE_BACKEND_ENGINE=pytorch
ANALYSIS_MODEL_ROOT=
# Optional semantic cache location. Defaults to the sibling data directory of STORAGE_ROOT.
PHOTO_SCREENER_DATA_ROOT=

# External provider settings stay in the Python service.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# Optional image-edit provider. Configure on the Python service only.
AIGC_API_KEY=
AIGC_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
AIGC_MODEL=qwen-image-3.0
AIGC_TIMEOUT_SECONDS=600
# DASHSCOPE_API_KEY is also accepted when AIGC_API_KEY is not set.
