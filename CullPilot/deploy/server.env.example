# Copy this file to /etc/cullpilot/cullpilot.env on the Linux server.
# Keep the real file outside Git and restrict it to the cullpilot user.

SERVER_PORT=8080
DATABASE_URL=jdbc:sqlite:/srv/cullpilot/data/cullpilot.db
STORAGE_ROOT=/srv/cullpilot/storage

PYTHON_API_BASE_URL=http://127.0.0.1:8001
PYTHON_API_TIMEOUT_SECONDS=600

# This directory is provisioned separately from the source repository.
ANALYSIS_MODEL_ROOT=/srv/cullpilot-models
ANALYSIS_ENABLE_DEEPFACE=true
ANALYSIS_ENABLE_SEMANTIC=true
ANALYSIS_ENABLE_CHINESE_CLIP=false
DEEPFACE_BACKEND_ENGINE=pytorch
PHOTO_SCREENER_OFFLINE=1
SEMANTIC_DEVICE=cpu

# Optional external instruction provider.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
