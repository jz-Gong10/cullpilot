# Copy this file to /etc/cullpilot/cullpilot.env on the Linux server.
# Keep the real file outside Git and restrict it to root.

SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:sqlite:/root/workspace/aic/CullPilot/data/cullpilot.db
STORAGE_ROOT=/root/workspace/aic/CullPilot/storage

PYTHON_API_BASE_URL=http://127.0.0.1:8001
PYTHON_API_TIMEOUT_SECONDS=600

# These directories are provisioned separately from the source repository and
# are never replaced by GitHub Actions.
ANALYSIS_MODEL_ROOT=/root/workspace/aic/demo/models
PHOTO_SCREENER_MODEL_ROOT=/root/workspace/aic/demo/models
PHOTO_SCREENER_DATA_ROOT=/root/workspace/aic/demo/data
ANALYSIS_ENABLE_DEEPFACE=true
ANALYSIS_ENABLE_SEMANTIC=true
ANALYSIS_ENABLE_CHINESE_CLIP=false
DEEPFACE_BACKEND_ENGINE=pytorch
PHOTO_SCREENER_OFFLINE=1
SEMANTIC_DEVICE=cpu
PYTHONUNBUFFERED=1

# Keep the Java process bounded on a small 8 GB server.
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1536m

# Optional external instruction provider.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# Optional image-edit provider. Set a real key in the server's private env file.
AIGC_API_KEY=
AIGC_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
AIGC_MODEL=qwen-image-3.0
AIGC_TIMEOUT_SECONDS=600
