# LLM API 密钥 (SophNet 网关)
# 在此填入你的密钥，程序启动时自动读取
SOPHNET_API_KEY=你的API密钥填在这里

# 模型与算法运行配置。PHOTO_SCREENER_MODEL_ROOT 留空时默认使用当前 demo/models/
PHOTO_SCREENER_MODEL_ROOT=
SEMANTIC_DEVICE=cpu
PHOTO_SCREENER_OFFLINE=1
ENABLE_DINO=1
ENABLE_CHINESE_CLIP=0
DEEPFACE_BACKEND_ENGINE=pytorch

# 可选语义模型配置
CHINESE_CLIP_USE_MODELSCOPE=0
DINO_MODEL_ID=facebook/dinov2-small

# LLM 配置（可按服务器实际网关修改）
LLM_MODEL=DeepSeek-Flash
LLM_BASE_URL=https://www.sophnet.com/api/open-apis/v1
LLM_TIMEOUT=15
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
